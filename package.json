{
  "name": " R-chat-app",
  "version": "1.0.0",
  "description": "This repository contains the chat application developed as project.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "serve": "nodemon backend/server-starter.js",
    "completed": "node backend/server-completed.js",
    "client": "cd client && npm run dev",
    "server": "nodemon backend/server-starter.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "node backend/server-starter.js"
  },
